rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function prof() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function signedIn() { return request.auth != null && request.auth.token.email_verified; }
    // 로그인·인증·승인 완료 (수강생 포함)
    function activeAny() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && prof().status == 'active';
    }
    // 대장님과 타투이스트 (수강생은 제외)
    function active() { return activeAny() && prof().role != 'student'; }
    function isInst() { return active() && prof().get('inst', false) == true; }
    function admin() { return active() && prof().role == 'admin'; }

    // ── 입력값 검사 도구 ──
    // 문서 ID: 영문·숫자·_·- 만 (따옴표 등으로 화면을 깨뜨리는 ID 방지)
    function okId(id) { return id.matches('^[A-Za-z0-9_-]{1,100}$'); }
    function isInt(v, lo, hi) { return v is int && v >= lo && v <= hi; }
    function txt(v, n) { return v is string && v.size() <= n; }
    // 한국 시간 기준 'YYYY-MM-DD'
    function ymdKst(ts) {
      let k = ts + duration.value(9, 'h');
      return string(k.year()) + '-' + (k.month() < 10 ? '0' : '') + string(k.month())
        + '-' + (k.day() < 10 ? '0' : '') + string(k.day());
    }
    // 오늘 날짜인지 (폰이 늦게 올리는 경우를 위해 이틀 전·하루 뒤까지 허용)
    function recentDay(d) {
      return d == ymdKst(request.time)
        || d == ymdKst(request.time - duration.value(1, 'd'))
        || d == ymdKst(request.time - duration.value(2, 'd'))
        || d == ymdKst(request.time + duration.value(1, 'd'));
    }
    // 그 사람의 그 달 판매수당이 이미 '정산' 처리됐는지
    function settledM(uid, d) {
      let p = d.split('-');
      let path = /databases/$(database)/documents/settle/$(p[0] + '-' + p[1] + '_' + uid);
      return exists(path) && get(path).data.get('paid', false) == true;
    }
    // 타투이스트가 넣는 판매 숫자 검사 (서비스·샘플은 0원·수당 없음)
    function saleNums(x) {
      return isInt(x.a, 0, 10000000) && isInt(x.qty, 1, 999)
        && x.c is number && x.c >= 0 && x.c <= 10000000
        && x.t in ['normal', 'review', 'service', 'sample']
        && ((x.t != 'service' && x.t != 'sample') || (x.a == 0 && x.c == 0));
    }
    // 토스: 결제 줄(최대 3줄) 합계와 카드 금액
    function payOk(p) { return p.m in ['cash', 'transfer', 'card'] && isInt(p.a, 0, 100000000); }
    function paysOk(ps, amt) {
      return ps is list && ps.size() >= 1 && ps.size() <= 3 && payOk(ps[0])
        && (ps.size() < 2 || payOk(ps[1])) && (ps.size() < 3 || payOk(ps[2]))
        && (ps.size() == 1 ? ps[0].a
            : ps.size() == 2 ? ps[0].a + ps[1].a
            : ps[0].a + ps[1].a + ps[2].a) == amt;
    }
    function cardOf(ps) {
      return (ps[0].m == 'card' ? ps[0].a : 0)
        + (ps.size() > 1 && ps[1].m == 'card' ? ps[1].a : 0)
        + (ps.size() > 2 && ps[2].m == 'card' ? ps[2].a : 0);
    }
    // 타투이스트끼리 토스 금액 계산이 앱 계산과 똑같은지 (숫자 조작 방지)
    function tossOk(x) {
      let fee = x.fee;
      let cf = x.cf;
      let amt = x.amt;
      return isInt(amt, 1, 100000000) && paysOk(x.pays, amt)
        && isInt(fee, 0, amt) && fee * 10 >= amt && fee * 5 <= amt
        && cf == math.round(cardOf(x.pays) * get(/databases/$(database)/documents/config/main).data.get('cardFee', 10) / 100.0)
        && x.aIn == 0
        && x.cfm in ['share', 'send', 'recv']
        && (x.cfm == 'send' ? (x.sIn == fee - cf && x.rIn == amt - fee)
            : x.cfm == 'share' ? (x.sIn == math.round(fee * (amt - cf) / (amt * 1.0)) && x.rIn == amt - cf - x.sIn)
            : (x.sIn == fee && x.rIn == amt - fee - cf));
    }

    // 사용자 프로필
    match /users/{u} {
      allow read: if signedIn() && (request.auth.uid == u || admin());
      // 가입 신청: 정해진 항목만 (강사 표시·쉐어비 등 몰래 넣기 방지)
      allow create: if signedIn() && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['name', 'nick', 'want', 'cohort', 'email', 'role', 'status', 'code'])
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'artist'
        && txt(request.resource.data.name, 40) && txt(request.resource.data.get('nick', ''), 40)
        && txt(request.resource.data.get('cohort', ''), 20) && txt(request.resource.data.get('email', ''), 120)
        && request.resource.data.get('want', 'artist') in ['artist', 'student']
        && request.resource.data.code == get(/databases/$(database)/documents/settings/app).data.signupCode;
      allow update: if admin();
      // 승인 대기 중인 가입 신청만 완전 삭제 가능 (기록이 있는 회원은 '삭제'=숨김 처리)
      allow delete: if admin() && resource.data.status == 'pending';
    }

    // 가입코드 (대장님만)
    match /settings/{d} {
      allow read, write: if admin();
    }

    // 제품, 가격, 수수료율, 마감, 지급 상태
    match /config/{d} {
      allow read: if active();
      allow write: if admin();
    }

    // 입고 기록 (대장님만)
    match /purchases/{id} {
      allow read, create, update: if admin();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 재고 실사, 시제 기록 (대장님만)
    match /counts/{id} {
      allow read, create, update: if admin();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }
    match /cash/{id} {
      allow read, create, update: if admin();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 셰어비 납부 기록 (대장님만)
    match /sharepay/{id} {
      allow read: if active() && (resource.data.uid == request.auth.uid || admin());
      allow create, update: if admin();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 토스 기록
    match /toss/{id} {
      allow read: if active() && (admin() || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if admin()
        || (active() && okId(id) && request.resource.data.from == request.auth.uid
            && request.resource.data.to != request.auth.uid
            && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
            && request.resource.data.st == 'pending'
            && request.resource.data.get('void', false) == false
            && tossOk(request.resource.data));
      allow update: if admin()
        || (active() && resource.data.to == request.auth.uid && resource.data.st == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])
            && request.resource.data.st in ['ok', 'no']);
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 공지사항
    match /notices/{id} {
      allow read: if activeAny();
      allow create, update: if admin();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 오늘의 문구 등 가게 안내 (타투이스트용 / 수강생용 따로, 대장님만 수정)
    // law = 문신사법 안내(모두), pub = 손님 페이지 정보(로그인 없이 누구나 읽음 · 공개 정보만)
    match /shop/{k} {
      allow read: if k == 'pub'
        || ((k == 'student' || k == 'law') && activeAny())
        || (k == 'artist' && active());
      allow write: if admin() && k in ['artist', 'student', 'law', 'pub'];
    }

    // 기본교육 (수강생·타투이스트 읽기, 대장·강사 작성)
    match /edu/{id} {
      allow read: if activeAny();
      allow create, update: if (admin() || isInst())
        && txt(request.resource.data.get('title', ''), 100) && txt(request.resource.data.get('body', ''), 8000)
        && txt(request.resource.data.get('cat', ''), 20) && txt(request.resource.data.get('img', ''), 700000);
      allow delete: if admin() || isInst();
    }

    // 타투 컨벤션 (대장이 직접 넣은 행사)
    match /conv/{id} {
      allow read: if active();
      allow write: if admin();
    }

    // 오류 보내기: 로그인한 사람은 본인 이름으로 쓰기만, 읽기·삭제는 대장님만
    match /errLog/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'msg', 'stack', 'where', 'memo', 'ver', 'ua', 'at'])
        && txt(request.resource.data.msg, 500) && txt(request.resource.data.get('stack', ''), 1500)
        && txt(request.resource.data.get('memo', ''), 200) && txt(request.resource.data.get('ua', ''), 200)
        && txt(request.resource.data.get('name', ''), 60) && txt(request.resource.data.get('where', ''), 40)
        && txt(request.resource.data.get('ver', ''), 20) && txt(request.resource.data.get('at', ''), 40);
      allow read, delete: if admin();
    }

    // 유령 키우기: 모두 읽기(광장), 본인은 이름·꾸미기·미션 날짜·게임 포인트만, 상태 요약(st·ex·full·mood)은 대장 앱이 계산해 저장
    match /pets/{u} {
      function petOk(d) {
        return txt(d.get('name', ''), 10) && txt(d.get('deco', ''), 12) && txt(d.get('col', ''), 12)
          && d.get('mis', []) is list && d.get('mis', []).size() <= 60;
      }
      // 오늘 날짜(한국 시간) 'YYYY-MM-DD'
      function kday() {
        let k = request.time + duration.value(9, 'h');
        return string(k.year()) + '-' + (k.month() < 10 ? '0' : '') + string(k.month()) + '-' + (k.day() < 10 ? '0' : '') + string(k.day());
      }
      // 게임 포인트(v1.43: 하루 제한 없앰, 대신 한 번 저장에 20 이하): 총 포인트(gpt)는 오늘 받은 만큼만 늘 수 있음, 쓴 포인트(gps)는 늘기만
      function gameOk(n, o) {
        let tod = n.get('gtod', 0);
        let oTod = o.get('gday', '') == n.get('gday', '') ? o.get('gtod', 0) : 0;
        let gain = n.get('gpt', 0) - o.get('gpt', 0);
        return tod is int && tod >= 0 && tod <= 5000
          && n.get('gpt', 0) is int && gain >= 0 && gain <= 20 && gain == tod - oTod
          && (gain == 0 || n.get('gday', '') == kday())
          && n.get('gps', 0) is int && n.get('gps', 0) >= o.get('gps', 0) && n.get('gps', 0) <= n.get('gpt', 0)
          && n.get('own', []) is list && n.get('own', []).size() <= 40
          && n.get('wkp', 0) is int && n.get('wkp', 0) >= 0 && n.get('wkp', 0) <= 30000
          && txt(n.get('wkw', ''), 10) && txt(n.get('gday', ''), 10)
          && n.get('best', {}) is map && n.get('best', {}).size() <= 10;
      }
      allow read: if active();
      allow create: if admin()
        || (active() && request.auth.uid == u
            && request.resource.data.keys().hasOnly(['name', 'deco', 'col', 'mis', 'at', 'gday', 'gtod', 'gpt', 'gps', 'own', 'wkw', 'wkp', 'best'])
            && petOk(request.resource.data) && gameOk(request.resource.data, {}));
      allow update: if admin()
        || (active() && request.auth.uid == u
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'deco', 'col', 'mis', 'at', 'gday', 'gtod', 'gpt', 'gps', 'own', 'wkw', 'wkp', 'best'])
            && petOk(request.resource.data) && gameOk(request.resource.data, resource.data));
      allow delete: if admin();
    }

    // 마지막 접속 시간: 본인만 기록(서버 시간만), 보는 건 대장님만
    match /seen/{u} {
      allow read, delete: if admin();
      allow create, update: if activeAny() && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }

    // 베드 센서(보드): 보드 전용 계정(bed@blackghost.app, 대장님이 Firebase 콘솔에서 만듦)만 beds/b1~b8 상태 기록.
    // st = 'on'(사용 중) | 'off'(비어 있음), up = 마지막 신호(서버 시간만), at = 상태가 바뀐 시간(서버 시간 또는 그대로)
    function bedDev() { return request.auth != null && request.auth.token.email == 'bed@blackghost.app'; }
    match /beds/{b} {
      allow read: if active();
      allow delete: if admin();
      allow create, update: if bedDev() && b.matches('^b[1-8]$')
        && request.resource.data.keys().hasOnly(['st', 'at', 'up', 'v', 'rssi'])
        && request.resource.data.st in ['on', 'off']
        && request.resource.data.up == request.time
        && (request.resource.data.at == request.time || (resource != null && request.resource.data.at == resource.data.at))
        && request.resource.data.v is string && request.resource.data.v.size() <= 20
        && request.resource.data.rssi is int;
    }

    // 작업자 명단(이름·닉네임만, 쉐어비 정보 없음)
    match /roster/{id} {
      allow read: if active();
      allow write: if admin();
    }

    // 비품·소모품 목록, 요청
    match /supplies/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }
    match /supreq/{id} {
      allow read: if active() && (admin() || resource.data.uid == request.auth.uid);
      allow create: if active() && okId(id) && request.resource.data.uid == request.auth.uid && request.resource.data.st == 'pending';
      allow update: if admin();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 판매수당 정산 상태 (타투이스트는 본인 것만 읽기)
    match /settle/{id} {
      allow read: if active() && (admin() || resource.data.uid == request.auth.uid);
      allow write: if admin();
    }

    // 쉐어비 월별 장부 (타투이스트는 본인 것만 읽고, 본인 칸에 납부확인 요청만 쓸 수 있음)
    match /shareLedger/{id} {
      allow read: if active() && (admin() || resource.data.uid == request.auth.uid);
      allow create: if admin()
        || (active() && request.resource.data.uid == request.auth.uid
            && id == request.auth.uid + '_' + request.resource.data.m
            && request.resource.data.keys().hasOnly(['uid', 'm', 'req'])
            && request.resource.data.m.matches('^20[0-9]{2}-[01][0-9]$')
            && request.resource.data.req.st == 'pending'
            && txt(request.resource.data.req.get('txt', ''), 500));
      allow update: if admin()
        || (active() && resource.data.uid == request.auth.uid
            && id == request.auth.uid + '_' + resource.data.m
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['req'])
            && request.resource.data.req.st == 'pending'
            && txt(request.resource.data.req.get('txt', ''), 500));
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 일일게스트 기록 (대장님만)
    match /guests/{id} {
      allow read, create, update: if admin();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 수강료 (대장님만, 수강생은 본인 것 읽기만 · 강사는 못 봄)
    match /coursePay/{id} {
      allow read: if activeAny() && (admin() || resource.data.uid == request.auth.uid);
      allow write: if admin();
    }

    // 수강 (수강생은 본인 것만 읽기, 강사·대장님은 전체)
    match /courses/{id} {
      allow read: if activeAny() && (admin() || isInst() || resource.data.uid == request.auth.uid);
      allow create: if admin();
      allow update: if admin()
        || (isInst() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['start', 'total', 'inst', 'instName', 'phone', 'insta']));
      allow delete: if admin();  // 완전 삭제는 대장님만
    }
    match /sessions/{id} {
      allow read: if activeAny() && (admin() || isInst() || resource.data.sid == request.auth.uid);
      allow create, update: if admin() || isInst();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }
    // 강사 전용 특이사항 (수강생에게 보이지 않음)
    match /studentNotes/{id} {
      allow read, create, update: if admin() || isInst();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 이벤트 · 추첨
    match /events/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 이벤트 회차, 복권 (결과는 긁은 뒤에만 읽을 수 있음), 당첨 쉐어비 할인
    match /eventRounds/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }
    match /tickets/{id} {
      allow read: if active() && (admin() || resource.data.uid == request.auth.uid);
      allow create: if admin();
      allow update: if admin()
        || (active() && resource.data.uid == request.auth.uid && resource.data.scratched == false
            // 매일 복권(exp)은 발행된 날(한국 시간)에만 긁을 수 있음 — 다음 날이면 소멸
            && (resource.data.get('exp', false) == false || resource.data.d == ymdKst(request.time))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scratched', 'scratchAt'])
            && request.resource.data.scratched == true
            && request.resource.data.scratchAt == request.time)
        || (active() && resource.data.uid == request.auth.uid && resource.data.scratched == true
            && !('revealed' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prize', 'revealed'])
            && request.resource.data.revealed == true
            && request.resource.data.prize == get(/databases/$(database)/documents/ticketPrizes/$(id)).data.prize);
      allow delete: if admin();
    }
    match /ticketPrizes/{id} {
      allow read: if active() && (admin()
        || (resource.data.uid == request.auth.uid
            && get(/databases/$(database)/documents/tickets/$(id)).data.scratched == true));
      allow create, update, delete: if admin();
    }
    match /evDisc/{id} {
      function tkt() { return get(/databases/$(database)/documents/tickets/$(id)).data; }
      // 긁은 시각(한국 시간)의 다음 달 'YYYY-MM'
      function nextYm(ts) {
        let k = ts + duration.value(9, 'h');
        let y = k.year();
        let mo = k.month();
        return mo == 12 ? string(y + 1) + '-01' : string(y) + '-' + (mo < 9 ? '0' : '') + string(mo + 1);
      }
      allow read: if active() && (admin() || resource.data.uid == request.auth.uid);
      allow create: if admin()
        || (active() && request.resource.data.uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'm', 'a', 'title', 'tid', 'void', 'at'])
            && request.resource.data.void == false
            && request.resource.data.tid == id
            && exists(/databases/$(database)/documents/tickets/$(id))
            // 할인 들어갈 달: 매일 복권은 발행 때 정한 달(pm), 그 외는 긁은 다음 달
            && request.resource.data.m == tkt().get('pm', nextYm(tkt().scratchAt))
            && get(/databases/$(database)/documents/tickets/$(id)).data.uid == request.auth.uid
            && get(/databases/$(database)/documents/tickets/$(id)).data.revealed == true
            && get(/databases/$(database)/documents/tickets/$(id)).data.prize != null
            && get(/databases/$(database)/documents/tickets/$(id)).data.prize.t == 'disc'
            && request.resource.data.a == get(/databases/$(database)/documents/tickets/$(id)).data.prize.a);
      allow update, delete: if admin();
    }

    // 레벨: 랭킹(점수만, 누구인지 없음)은 모두, 내 점수 내역은 본인만, 가산점은 대장님만
    match /lvRank/{id} {
      allow read: if active();
      allow write: if admin();
    }
    match /lvMine/{id} {
      allow read: if active() && (admin() || resource.data.uid == request.auth.uid);
      allow write: if admin();
    }
    match /lvBonus/{id} {
      allow read, create, update: if admin();
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 판매 리뷰 사진 (판매 상세를 열 때만 불러옴 · 판매자 본인과 대장님만)
    match /saleImg/{id} {
      allow read: if active() && (admin() || resource.data.uid == request.auth.uid);
      allow create, update: if admin()
        || (active() && request.resource.data.uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'img'])
            && request.resource.data.img is string && request.resource.data.img.size() < 700000
            && request.resource.data.img.matches('^data:image/[a-z]+;base64,[A-Za-z0-9+/=]+$')
            && get(/databases/$(database)/documents/sales/$(id)).data.uid == request.auth.uid);
      allow delete: if admin();  // 완전 삭제는 대장님만
    }

    // 판매 내역
    match /sales/{id} {
      allow read: if active() && (resource.data.uid == request.auth.uid || admin());
      allow create: if active()
        && (request.resource.data.uid == request.auth.uid || admin())
        && (request.resource.data.t != 'etc' || admin())
        && (request.resource.data.t != 'service' || admin() || request.resource.data.ap == 'pending')
        && (admin() || (okId(id) && recentDay(request.resource.data.d)
            && saleNums(request.resource.data)
            && request.resource.data.get('void', false) == false
            && !settledM(request.auth.uid, request.resource.data.d)))
        && (request.resource.data.t != 'review'
            || request.resource.data.sub == 'sep'
            || request.resource.data.rid != '' || request.resource.data.rn != '' || request.resource.data.img != '');
      allow update: if admin()
        || (active() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.void == resource.data.void
            && request.resource.data.t == resource.data.t
            && request.resource.data.t != 'etc'
            && (request.resource.data.t == 'service'
                ? request.resource.data.ap == 'pending'
                : request.resource.data.get('ap', '') == resource.data.get('ap', ''))
            && request.resource.data.hist.size() == resource.data.hist.size() + 1
            && request.resource.data.hist.hasAll(resource.data.hist)
            && request.resource.data.d == resource.data.d
            && saleNums(request.resource.data)
            && !settledM(resource.data.uid, resource.data.d));
      allow delete: if admin();  // 완전 삭제는 대장님만
    }
  }
}
